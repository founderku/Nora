# Nora - speed settings for Apache (cPanel).
# Every block is wrapped in <IfModule>, so a module the host does not have is
# simply skipped instead of breaking the site.

# ---- Compression: send text files gzipped (typically 70-80% smaller) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---- Make sure .webp images are served with the right type ----
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# ---- Browser caching: repeat visits and page-to-page clicks reuse files ----
<IfModule mod_expires.c>
  ExpiresActive On
  # Image file names in images/ contain a fingerprint of their content, so a
  # changed image always gets a new name and can be cached for a long time.
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  # CSS/JS are linked as style.css?v=2 / script.js?v=2; bump the number
  # whenever they change so visitors fetch the new version.
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  # Pages themselves are re-checked every visit so edits show up immediately.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
